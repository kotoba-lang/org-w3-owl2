{:paths ["src"]
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "0ffd5f6340af50871d4759b06e02ac4fbf9a4bdf"}
        io.github.kotoba-lang/dsl-core
        {:git/sha "ac8554fe4c29dc55fc78a850044888dfcc4e1e8b"}}
 :aliases
 ;; TEST ONLY, and the distinction is the point: this library emits rules as
 ;; data and depends on nothing to do it. But a ruleset that has never been
 ;; run is a claim, not an implementation -- the engine is what says whether
 ;; a fixpoint terminates and derives what the W3C document says it derives.
 ;; So the evaluator is a test dependency and never a runtime one.
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      io.github.kotoba-lang/datalog
                      {:git/sha "2858919fc567ec63ac845ab6807e2f993b2d6df7"}
                      io.github.kotoba-lang/datom-source
                      {:git/sha "4ca0096cbe83e98f80510f2c3e593d5498eadcbc"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
